          "name": "TC-SEAT-EP-01 | seat_number=0 (lop khong hop le - duoi)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code la 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Ket qua status = error', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.status).to.eql('error');",
                  "});",
