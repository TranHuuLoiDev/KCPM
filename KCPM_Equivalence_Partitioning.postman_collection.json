{
  "info": {
    "name": "KCPM - Equivalence Partitioning Test Suite",
    "description": "Bo test case Phan Hoach Lop Tuong Duong (EP) cho project KCPM. Moi field co du 2-3 lop: duoi bien (invalid) / trong (valid) / tren bien (invalid). Chinh bien 'base_url' truoc khi chay, va sua cac id (room_id, theatre_id, movie_id, seat_type_id, user_id...) cho khop voi du lieu that trong database cua ban.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/movie-ticket-booking/backend/api.php"
    }
  ],
  "item": [
    {
      "name": "EP - Seats (seat_number: 1-12)",
